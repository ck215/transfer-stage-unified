/* style.qss */
QWidget {
    background-color: #1E1E1E;
    color: #E0E0E0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
}

QDialog, QMainWindow {
    background-color: #121212;
}

QDockWidget {
    font-weight: bold;
    color: #E0E0E0;
}

QDockWidget::title {
    background: #252526;
    padding: 8px;
    border-bottom: 1px solid #333333;
}

QLabel {
    color: #E0E0E0;
}

QLabel[class="header"] {
    font-size: 16px;
    font-weight: 600;
    color: #4DAAF2;
    margin-top: 12px;
    margin-bottom: 8px;
}

QLabel#valueLabel {
    color: #73D073;
    font-weight: 600;
    padding: 4px;
}

QLabel#fileLabel {
    color: #E5B567;
    font-size: 12px;
}

QLineEdit {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 6px;
    color: #FFFFFF;
    selection-background-color: #264F78;
}

QLineEdit:focus {
    border: 1px solid #0078D4;
}

QPushButton {
    background-color: #0078D4;
    color: #FFFFFF;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 4px;
    border: none;
}

QPushButton:hover {
    background-color: #106EBE;
}

QPushButton:pressed {
    background-color: #005A9E;
}

QPushButton#toggleTrue {
    background-color: #107C10;
}
QPushButton#toggleTrue:hover {
    background-color: #0B5A0B;
}

QPushButton#toggleFalse {
    background-color: #D13438;
}
QPushButton#toggleFalse:hover {
    background-color: #A80000;
}

QPushButton#filePicker {
    background-color: #CA5010;
    color: #FFFFFF;
}
QPushButton#filePicker:hover {
    background-color: #A93C08;
}

QComboBox {
    background-color: #2D2D30;
    border: 1px solid #3E3E42;
    border-radius: 4px;
    padding: 4px;
    color: #FFFFFF;
}

QComboBox::drop-down {
    border-left: 1px solid #3E3E42;
    width: 24px;
}

QComboBox:focus {
    border: 1px solid #0078D4;
}

QFrame#card {
    background-color: #252526;
    border-radius: 6px;
    border: 1px solid #333333;
    padding: 12px;
    margin-bottom: 12px;
}

QListWidget {
    background-color: #1E1E1E;
    border: none;
    outline: none;
}

QListWidget::item {
    padding: 8px;
    border-radius: 4px;
    margin: 2px 4px;
}

QListWidget::item:hover {
    background-color: #2A2D2E;
}

QListWidget::item:selected {
    background-color: #37373D;
    color: #FFFFFF;
}

QTextEdit {
    background-color: #1E1E1E;
    border: 1px solid #333333;
    padding: 8px;
    color: #73D073;
    font-family: 'Courier New', monospace;
    border-radius: 4px;
}

QCheckBox {
    spacing: 8px;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3E3E42;
    border-radius: 3px;
    background-color: #2D2D30;
}
QCheckBox::indicator:checked {
    background-color: #0078D4;
    border-color: #0078D4;
}
